DATABASE_URL="postgres://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgres://user:password@host:5432/postgres"
TOKEN_ENCRYPTION_KEY=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_SECRET=""
APP_URL="http://localhost:3000"
# Shared secret for Vercel Cron requests. When CRON_SECRET is set as a Vercel
# project env var, Vercel Cron automatically sends
# `Authorization: Bearer $CRON_SECRET` with each invocation of a path listed
# in vercel.json's "crons" — no separate header configuration needed.
CRON_SECRET=""
# Browser-exposed Supabase project URL and anon/publishable key, used by
# lib/supabase-client.ts to subscribe to Realtime changes on the `events`
# table from the client. Safe to expose publicly (protected by RLS).
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Legacy JWT secret from the Supabase dashboard (Project Settings > API >
# Legacy JWT secret). Used server-side only (lib/supabase-realtime-token.ts)
# to self-sign short-lived HS256 tokens that Supabase's Realtime/PostgREST
# still verify, so NextAuth-authenticated users can subscribe to Realtime
# with a Postgres role/identity that RLS policies can check. Never expose
# this value to the browser.
SUPABASE_JWT_SECRET=""
