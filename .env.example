APP_URL="http://localhost:3000"
# Shared secret for Vercel Cron requests. When CRON_SECRET is set as a Vercel
# project env var, Vercel Cron automatically sends
# `Authorization: Bearer $CRON_SECRET` with each invocation of a path listed
# in vercel.json's "crons" — no separate header configuration needed.
